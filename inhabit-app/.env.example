# Base de données : SQLite en local, PostgreSQL en production (postgres://...)
# Sur Vercel : chaîne « Transaction pooler » de Supabase (port 6543).
# Les tables Payload sont dans le schéma « payload » et se créent par migrations (src/migrations).
DATABASE_URL=file:./inhabit.db
# Nombre max de connexions par instance (Postgres uniquement, 5 par défaut)
DATABASE_POOL_MAX=
PAYLOAD_SECRET=change-moi-chaine-aleatoire-longue
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email qui reçoit les notifications (si non défini dans l'admin)
ADMIN_EMAIL=

# Envoi d'emails (laisser vide en local : les emails s'affichent dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stockage des images sur Supabase Storage (laisser vide en local : images sur le disque, dossier media/)
# Clés à créer dans Supabase : Project Settings → Storage → S3 Access Keys
S3_BUCKET=media
S3_ENDPOINT=
S3_REGION=eu-west-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Adresse publique du bucket : https://<ref>.supabase.co/storage/v1/object/public/media
S3_PUBLIC_URL=

# Compte administrateur de test créé par npm run seed (local uniquement)
SEED_ADMIN_EMAIL=admin@inhabit.test
SEED_ADMIN_PASSWORD=change-moi
